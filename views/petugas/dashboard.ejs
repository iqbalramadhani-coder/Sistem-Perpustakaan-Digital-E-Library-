<%- include('../partials/header') %>

<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-800">Dashboard Petugas</h2>
  <p class="text-gray-600">Kelola sirkulasi buku perpustakaan.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="p-3 rounded-full bg-yellow-100 text-yellow-600 mr-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <div>
        <p class="text-sm text-gray-500 font-medium">Menunggu Persetujuan</p>
        <p class="text-3xl font-bold text-gray-800"><%= pendingLoans %></p>
      </div>
    </div>
  </div>
  
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="p-3 rounded-full bg-blue-100 text-blue-600 mr-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
      </div>
      <div>
        <p class="text-sm text-gray-500 font-medium">Buku Sedang Dipinjam</p>
        <p class="text-3xl font-bold text-gray-800"><%= activeLoans %></p>
      </div>
    </div>
  </div>
</div>

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 text-center">
  <h3 class="text-lg font-bold text-gray-800 mb-2">Proses Peminjaman & Pengembalian</h3>
  <p class="text-gray-600 mb-4">Setujui pengajuan peminjam atau proses buku yang dikembalikan.</p>
  <a href="/petugas/loans" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-blue-700 transition">Kelola Sirkulasi</a>
</div>

<%- include('../partials/footer') %>
