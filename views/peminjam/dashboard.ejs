<%- include('../partials/header') %>

<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-800">Beranda Peminjam</h2>
  <p class="text-gray-600">Selamat datang, jelajahi katalog dan pantau peminjamanmu.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="p-3 rounded-full bg-blue-100 text-blue-600 mr-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
      </div>
      <div>
        <p class="text-sm text-gray-500 font-medium">Total Peminjaman</p>
        <p class="text-3xl font-bold text-gray-800"><%= userLoans %></p>
      </div>
    </div>
  </div>
  
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="p-3 rounded-full bg-green-100 text-green-600 mr-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <div>
        <p class="text-sm text-gray-500 font-medium">Sedang Dipinjam</p>
        <p class="text-3xl font-bold text-gray-800"><%= activeLoans %></p>
      </div>
    </div>
  </div>
  
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="p-3 rounded-full bg-red-100 text-red-600 mr-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <div>
        <p class="text-sm text-gray-500 font-medium">Total Denda</p>
        <p class="text-3xl font-bold text-gray-800">Rp <%= totalDenda %></p>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <h3 class="text-lg font-bold text-gray-800 mb-2">Cari Buku Favoritmu</h3>
    <p class="text-gray-600 mb-4 text-sm">Jelajahi ribuan koleksi buku digital dan fisik kami.</p>
    <a href="/peminjam/books" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-blue-700 transition">Lihat Katalog</a>
  </div>
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <h3 class="text-lg font-bold text-gray-800 mb-2">Cek Status Peminjaman</h3>
    <p class="text-gray-600 mb-4 text-sm">Pantau tanggal jatuh tempo agar terhindar dari denda.</p>
    <a href="/peminjam/history" class="inline-block bg-purple-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-purple-700 transition">Lihat Riwayat</a>
  </div>
</div>

<%- include('../partials/footer') %>
