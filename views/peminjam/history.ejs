<%- include('../partials/header') %>

<div class="mb-6 flex justify-between items-center">
  <div>
    <h2 class="text-2xl font-bold text-gray-800">Riwayat Peminjaman</h2>
    <p class="text-gray-600">Pantau status buku yang kamu pinjam.</p>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Buku</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tgl Pinjam</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jatuh Tempo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Denda</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% loans.forEach(loan => { %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="font-medium text-gray-900"><%= loan.book.judul %></div>
            <div class="text-xs text-gray-500"><%= loan.book.pengarang %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(loan.tglPinjam).toLocaleDateString('id-ID') %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(loan.tglJatuhTempo).toLocaleDateString('id-ID') %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <% if(loan.status === 'PENDING') { %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Menunggu</span>
            <% } else if(loan.status === 'DIPINJAM') { %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Dipinjam</span>
            <% } else if(loan.status === 'KEMBALI') { %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Dikembalikan</span>
            <% } %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-red-600">
            <%= loan.denda > 0 ? `Rp ${loan.denda}` : '-' %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
