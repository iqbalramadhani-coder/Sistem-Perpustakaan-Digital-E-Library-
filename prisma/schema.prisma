generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  nama     String
  role     String // ADMIN, PETUGAS, PEMINJAM
  nisn     String?
  telepon  String?

  loans       Loan[]        @relation("UserLoans")
  processedBy Loan[]        @relation("PetugasLoans")
  ActivityLog ActivityLog[]
}

model Category {
  id           Int    @id @default(autoincrement())
  namaKategori String
  kodeRak      String

  books Book[]
}

model Book {
  id         Int      @id @default(autoincrement())
  judul      String
  pengarang  String
  penerbit   String
  tahun      String
  isbn       String
  stok       Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  loans      Loan[]
}

model Loan {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation("UserLoans", fields: [userId], references: [id])
  bookId        Int
  book          Book      @relation(fields: [bookId], references: [id])
  tglPinjam     DateTime
  tglJatuhTempo DateTime
  tglKembali    DateTime?
  status        String // PENDING, DIPINJAM, KEMBALI, DITOLAK
  denda         Int       @default(0)
  petugasId     Int?
  petugas       User?     @relation("PetugasLoans", fields: [petugasId], references: [id])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  aksi       String
  keterangan String
  createdAt  DateTime @default(now())
}
